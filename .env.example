# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://minicrm:minicrm_dev_pw@localhost:5432/minicrm_dev

# Auth.js - generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional Google OAuth (architecture-ready, not required to run the app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage (object storage abstraction, e.g. S3-compatible) ---
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- Email (transactional email abstraction) ---
EMAIL_PROVIDER=console # console | resend | ses | smtp
EMAIL_API_KEY=
EMAIL_FROM=MiniCRM <no-reply@minicrm.example>

# --- WhatsApp Business API (leave unset to run the mock adapter) ---
WHATSAPP_MODE=mock # mock | live
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Meta (Facebook Lead Ads) ---
META_MODE=mock # mock | live
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# --- Instagram (Meta Graph API) ---
INSTAGRAM_MODE=mock # mock | live
INSTAGRAM_ACCESS_TOKEN=

# --- Gmail ---
GMAIL_MODE=mock # mock | live
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Payments (provider-agnostic; Stripe/Razorpay compatible) ---
PAYMENT_PROVIDER=mock # mock | stripe | razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI provider abstraction ---
AI_PROVIDER=mock # mock | anthropic | openai
AI_API_KEY=

# --- Secret encryption (integration credentials at rest) ---
# generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=

# --- Rate limiting (in-memory by default; point at Redis in production) ---
REDIS_URL=

# --- Internal background jobs (cron-triggered) ---
# generate with: openssl rand -hex 24
INTERNAL_JOB_TOKEN=
